# =========================================================================
# CONFIGURACIÓN DEL SERVIDOR LOCAL (DASHBOARD REDES)
# =========================================================================
# Todas las credenciales, tokens de API e integraciones de marcas se configuran
# EXCLUSIVAMENTE a través de la interfaz web de la herramienta (Configuración).
# Ya no es necesario definir tokens de API en este archivo .env personal.
# =========================================================================

# Host donde se expondrá la API del Backend (por defecto 127.0.0.1)
DASHBOARD_REDES_HOST=127.0.0.1

# Puerto del Backend (por defecto 9512)
DASHBOARD_REDES_PORT=9512

# Etiqueta informativa que se expone en /api/health. No altera el comportamiento.
# Para probar sin credenciales usa los datos de ejemplo (ver README).
DASHBOARD_REDES_MODE=live
